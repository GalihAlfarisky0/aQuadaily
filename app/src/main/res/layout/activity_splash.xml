<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    tools:context="com.aquadaily.app.ui.splash.SplashActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.15" />

    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_water_splash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guidelineTop" />

    <TextView
        android:id="@+id/tvSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:text="AquaDaily"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivSplashLogo" />

    <TextView
        android:id="@+id/tvSplashSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.85"
        android:fontFamily="sans-serif-medium"
        android:text="@string/splash_subtitle"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSplashTitle" />

    <!-- Water Animation Area -->
    <View
        android:id="@+id/viewSplashImpact"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivWaterDrop"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:alpha="0"
        android:src="@drawable/ic_water_splash"
        app:layout_constraintBottom_toTopOf="@id/viewSplashImpact"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Ripple Effect Views (programmatic or static for animation) -->
    <View
        android:id="@+id/viewRipple1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:alpha="0"
        android:background="@drawable/bg_ripple_splash"
        app:layout_constraintBottom_toBottomOf="@id/viewSplashImpact"
        app:layout_constraintEnd_toEndOf="@id/viewSplashImpact"
        app:layout_constraintStart_toStartOf="@id/viewSplashImpact"
        app:layout_constraintTop_toTopOf="@id/viewSplashImpact" />

    <View
        android:id="@+id/viewRipple2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:alpha="0"
        android:background="@drawable/bg_ripple_splash"
        app:layout_constraintBottom_toBottomOf="@id/viewSplashImpact"
        app:layout_constraintEnd_toEndOf="@id/viewSplashImpact"
        app:layout_constraintStart_toStartOf="@id/viewSplashImpact"
        app:layout_constraintTop_toTopOf="@id/viewSplashImpact" />

</androidx.constraintlayout.widget.ConstraintLayout>