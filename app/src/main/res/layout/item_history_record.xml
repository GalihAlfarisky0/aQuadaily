<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="#F1F8E9"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivStatus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_completion"
                app:tint="#4CAF50" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvLabelRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/daily_record_label"
            android:textColor="#9E9E9E"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            app:layout_constraintStart_toEndOf="@id/cvIcon"
            app:layout_constraintTop_toTopOf="@id/cvIcon" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="12 July"
            android:textColor="#263238"
            android:textSize="15sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@id/tvLabelRecord"
            app:layout_constraintTop_toBottomOf="@id/tvLabelRecord"
            app:layout_constraintEnd_toStartOf="@id/tvSeparator" />

        <TextView
            android:id="@+id/tvSeparator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="·"
            android:textColor="#BDBDBD"
            app:layout_constraintBottom_toBottomOf="@id/tvDate"
            app:layout_constraintStart_toEndOf="@id/tvDate"
            app:layout_constraintTop_toTopOf="@id/tvDate"
            app:layout_constraintEnd_toStartOf="@id/tvTotalAmount" />

        <TextView
            android:id="@+id/tvTotalAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-black"
            android:text="2.100 ml"
            android:textColor="#4CAF50"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="@id/tvDate"
            app:layout_constraintStart_toEndOf="@id/tvSeparator"
            app:layout_constraintTop_toTopOf="@id/tvDate"
            app:layout_constraintEnd_toStartOf="@id/viewStatusDot"
            app:layout_constraintHorizontal_bias="0" />

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_status_dot"
            app:layout_constraintBottom_toBottomOf="@id/tvGoalStatus"
            app:layout_constraintEnd_toStartOf="@id/tvGoalStatus"
            app:layout_constraintTop_toTopOf="@id/tvGoalStatus"
            app:layout_constraintStart_toEndOf="@id/tvTotalAmount"
            app:layout_constraintHorizontal_bias="1" />

        <TextView
            android:id="@+id/tvGoalStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="@string/goal_met"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- We'll hide or keep progress indicator small if needed,
             but for premium look in image 2, let's keep it very subtle or remove it -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIntake"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:indicatorColor="#4CAF50"
            app:layout_constraintStart_toStartOf="@id/tvDate"
            app:layout_constraintTop_toBottomOf="@id/tvDate"
            app:trackColor="#E8F5E9"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp"
            android:progress="100"
            android:visibility="gone"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>