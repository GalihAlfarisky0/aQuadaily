<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AQuadaily" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#D1E4FF</item>
        <item name="colorOnPrimaryContainer">#001D36</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">#E3F2FD</item>
        <item name="colorOnSecondaryContainer">#001E30</item>
        <item name="colorTertiary">#03A9F4</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">#E1F5FE</item>
        <item name="colorOnTertiaryContainer">#01579B</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#1A1C1E</item>
        <item name="colorOutline">#73777F</item>

        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="TimePickerTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">#1A1C1E</item>
        <item name="colorSurfaceVariant">#E3F2FD</item>
        <item name="colorOnSurfaceVariant">@color/primary</item>
        <item name="colorSecondaryContainer">#E3F2FD</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <item name="colorTertiaryContainer">#E3F2FD</item>
        <item name="colorOnTertiaryContainer">@color/primary</item>
        <item name="android:textColorPrimary">#1A1C1E</item>
        <item name="android:textColorSecondary">@color/gray_text</item>
        <item name="colorControlHighlight">#D1E4FF</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlNormal">#73777F</item>
    </style>

    <style name="Theme.AQuadaily" parent="Base.Theme.AQuadaily" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AQuadaily</item>
    </style>
</resources>